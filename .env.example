# WorkGuard configuration (all optional; defaults work offline in heuristic mode)

# --- LLM ---
# auto = use OpenAI-compatible API when key present, otherwise offline heuristic mode
# Values: auto | openai | heuristic
WORKGUARD_LLM_PROVIDER=auto
WORKGUARD_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Example: https://open.bigmodel.cn/api/paas/v4 (GLM)
OPENAI_BASE_URL=

# --- Storage ---
# WORKGUARD_DB_URL=sqlite:///./data/workguard.db
# For PostgreSQL+pgvector: postgresql+psycopg://workguard:workguard@localhost:5432/workguard
WORKGUARD_DATA_DIR=./data/artifacts
WORKGUARD_CHECKPOINT_PATH=./data/workguard_checkpoints.db
WORKGUARD_MAX_UPLOAD_BYTES=20971520
WORKGUARD_MAX_OFFICE_UNCOMPRESSED_BYTES=104857600
WORKGUARD_MAX_OFFICE_ARCHIVE_ENTRIES=10000

# --- API boundary ---
# Keep blank only for a loopback-only local demo. Set a strong random value for
# any shared deployment and send it as X-API-Key or Authorization: Bearer.
WORKGUARD_API_KEY=
# Enable signed X-Workspace-Key capability tokens. Requires the secret below,
# or falls back to WORKGUARD_API_KEY as the signing secret.
WORKGUARD_WORKSPACE_AUTH=0
WORKGUARD_WORKSPACE_TOKEN_SECRET=
WORKGUARD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8765,http://localhost:8765
WORKGUARD_AUTO_MIGRATE=1
WORKGUARD_TASK_WORKER=1
WORKGUARD_TASK_POLL_SECONDS=0.5
WORKGUARD_TASK_LEASE_SECONDS=900
WORKGUARD_TASK_MAX_ATTEMPTS=3

# --- Safety ---
# Controlled in-place write-back for DOCX/XLSX (0 = suggestion patches only, default)
WORKGUARD_OFFICE_WRITE=0
# Facts below this value become Unverified and cannot trigger conflict detection.
WORKGUARD_FACT_UNVERIFIED_THRESHOLD=0.6
# Conflicts below this value become Need Review and cannot be auto-updated.
WORKGUARD_CONFLICT_REVIEW_THRESHOLD=0.7
# Fuzzy entity auto-link threshold.
WORKGUARD_ENTITY_AUTO_LINK_THRESHOLD=0.82

# --- Feishu (Lark) integration ---
# Without credentials the integration degrades gracefully (status endpoint
# reports not_configured; sync/webhook return 503 with a clear message).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Custom-bot webhook for approval notifications.
FEISHU_WEBHOOK_URL=
# chat_id/open_id/etc. for the published app bot.
FEISHU_NOTIFY_RECEIVE_ID=
FEISHU_NOTIFY_RECEIVE_ID_TYPE=chat_id
# Drive folder token, or root for the app's own Drive root.
FEISHU_FOLDER_TOKEN=
# Event subscription verification token (required for webhook).
FEISHU_VERIFICATION_TOKEN=
# Encrypted events are rejected until decryption is configured.
FEISHU_ENCRYPT_KEY=
# Publicly reachable WorkGuard origin used in bot approval links and as the
# base for the Feishu event callback, e.g. https://workguard.example.com
WORKGUARD_PUBLIC_BASE_URL=
# FEISHU_BASE_URL=https://open.feishu.cn
